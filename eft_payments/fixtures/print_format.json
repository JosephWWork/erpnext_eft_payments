  "html": "{% set pe = doc %}\n\n<!-- Header -->\n<div id=\"header-html\" class=\"hidden-pdf\">\n    <div class=\"print-heading\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td style=\"width: 65%; vertical-align: top;\">\n                    {{ letter_head }}\n                </td>\n                <td style=\"width: 35%; vertical-align: top;\">\n                    <div style=\"font-size: 24px; font-weight: bold; margin-bottom: 2px; text-align: right;\">Remittance Advice</div>\n                    <table style=\"border-collapse: collapse; float: right\">\n                        <tr>\n                            <th style=\"text-align: right\">Reference</th>\n                            <td>{{ pe.name }}</td>\n                        </tr>\n                        <tr>\n                            <th style=\"text-align: right\">Date</th>\n                            <td>{{ frappe.format(pe.posting_date, {\"fieldtype\":\"Date\"}) }}</td>\n                        </tr>\n                        <tr>\n                            <th style=\"text-align: right; white-space: nowrap\">Payment Run</th>\n                            <td>{{ pe.payment_run or \"—\" }}</td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>\n\n<!-- Payee Info -->\n<table style=\"width: 100%; border-collapse: collapse; margin-top: 1em;\">\n    <tr>\n        <th>Paid To:</th>\n        <td>\n            <div>{{ pe.party_name }}</div>\n            <div>{{ pe.party }}</div>\n        </td>\n        <th>Payment Method:</th>\n        <td>{{ pe.mode_of_payment }}</td>\n    </tr>\n</table>\n\n<div class=\"report-body\">\n<!-- References -->\n    <table style=\"border-collapse: collapse; margin-top: 1.5em; width: 100%\">\n        <thead style=\"border-bottom: 2px solid #000\">\n            <tr>\n                <th class=\"align-bottom\">Type</th>\n                <th class=\"align-bottom\">Reference</th>\n                <th class=\"align-bottom\">Date</th>\n                <th class=\"align-bottom\" style=\"text-align: right\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for ref in pe.references %}\n                {% if ref.reference_doctype == \"Purchase Invoice\" %}\n                    {% set source_doc = frappe.get_doc(\"Purchase Invoice\", ref.reference_name) %}\n                    {% set ref_number = source_doc.bill_no if source_doc.bill_no else ref.reference_name %}\n                    {% set ref_type = \"Invoice\" %}\n                    {% set ref_date = source_doc.bill_date if (source_doc.bill_date and source_doc.bill_date != source_doc.posting_date) else source_doc.posting_date %}\n                {% elif ref.reference_doctype == \"Journal Entry\" %}\n                    {% set source_doc = frappe.get_doc(\"Journal Entry\", ref.reference_name) %}\n                    {% set ref_number = source_doc.bill_no if source_doc.bill_no else ref.reference_name %}\n                    {% set ref_type = \"Credit\" %}\n                    {% set ref_date = source_doc.bill_date if (source_doc.bill_date and source_doc.bill_date != source_doc.posting_date) else source_doc.posting_date %}\n                {% else %}\n                    {% set ref_number = ref.reference_name %}\n                    {% set ref_type = ref.reference_doctype %}\n                    {% set ref_date = None %}\n                {% endif %}\n                <tr style=\"border-bottom: 1px solid #ccc\">\n                    <td>{{ ref_type }}</td>\n                    <td>{{ ref_number }}</td>\n                    <td>{{ frappe.format(ref_date, {\"fieldtype\":\"Date\"}) if ref_date else \"—\" }}</td>\n                    <td style=\"text-align: right\">{{ frappe.format(ref.allocated_amount, {\"fieldtype\":\"Currency\"}) }}</td>\n                </tr>\n            {% endfor %}\n            <tr style=\"border-top: 2px solid #000\">\n                <td colspan=\"3\" style=\"text-align: right\"><b>Total Payment:</b></td>\n                <td style=\"text-align: right\"><b>{{ frappe.format(pe.paid_amount, {\"fieldtype\":\"Currency\"}) }}</b></td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n    <div class=\"text-center small page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </div>\n</div>\n\n<script>\nvar vars={};\nvar x=window.location.search.substring(1).split('&');\nfor (var i in x) {\n  var z=x[i].split('=',2);\n  vars[z[0]] = unescape(z[1]);\n}\ndocument.getElementsByClassName('page')[0].innerHTML = vars.page;\ndocument.getElementsByClassName('topage')[0].innerHTML = vars.topage;\n</script>",
