  "html": "{% set pe = doc %}\n\n<div style=\"font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto; padding: 20px;\">\n\n    <!-- Header -->\n    <table width=\"100%\" style=\"margin-bottom: 30px;\">\n        <tr>\n            <td>\n                <h2 style=\"margin:0; color:#333;\">Remittance Advice</h2>\n                <p style=\"margin:4px 0; color:#888; font-size:13px;\">\n                    Electronic Funds Transfer\n                </p>\n            </td>\n            <td align=\"right\">\n                <div style=\"font-size:13px; color:#555;\">\n                    <strong>{{ pe.company }}</strong><br>\n                    Date: {{ frappe.format(pe.posting_date, {\"fieldtype\":\"Date\"}) }}<br>\n                    Reference: {{ pe.name }}\n                </div>\n            </td>\n        </tr>\n    </table>\n\n    <hr style=\"border:none; border-top:2px solid #333; margin-bottom:20px;\">\n\n    <!-- Payee Info -->\n    <table width=\"100%\" style=\"margin-bottom:24px;\">\n        <tr>\n            <td style=\"font-size:13px;\">\n                <strong>Paid To:</strong><br>\n                <span style=\"font-size:15px;\">{{ pe.party_name }}</span><br>\n                <span style=\"color:#888; font-size:12px;\">\n                    Supplier Code: {{ pe.party }}\n                </span>\n            </td>\n            <td align=\"right\" style=\"font-size:13px;\">\n                <strong>Payment Method:</strong> {{ pe.mode_of_payment }}<br>\n                <strong>Payment Run:</strong> {{ pe.payment_run or \"—\" }}\n            </td>\n        </tr>\n    </table>\n\n    <!-- Reference Table -->\n    <table width=\"100%\" style=\"border-collapse:collapse; font-size:13px; margin-bottom:24px;\">\n        <thead>\n            <tr style=\"background:#f5f5f5;\">\n                <th style=\"border:1px solid #ddd; padding:8px; text-align:left;\">Type</th>\n                <th style=\"border:1px solid #ddd; padding:8px; text-align:left;\">Reference</th>\n                <th style=\"border:1px solid #ddd; padding:8px; text-align:left;\">Date</th>\n                <th style=\"border:1px solid #ddd; padding:8px; text-align:right;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for ref in pe.references %}\n                {% if ref.reference_doctype == \"Purchase Invoice\" %}\n                    {% set source_doc = frappe.get_doc(\"Purchase Invoice\", ref.reference_name) %}\n                    {% set ref_number = source_doc.bill_no if source_doc.bill_no else ref.reference_name %}\n                    {% set ref_type = \"Invoice\" %}\n                    {% set ref_date = source_doc.bill_date if (source_doc.bill_date and source_doc.bill_date != source_doc.posting_date) else source_doc.posting_date %}\n                {% elif ref.reference_doctype == \"Journal Entry\" %}\n                    {% set source_doc = frappe.get_doc(\"Journal Entry\", ref.reference_name) %}\n                    {% set ref_number = source_doc.bill_no if source_doc.bill_no else ref.reference_name %}\n                    {% set ref_type = \"Credit\" %}\n                    {% set ref_date = source_doc.bill_date if (source_doc.bill_date and source_doc.bill_date != source_doc.posting_date) else source_doc.posting_date %}\n                {% else %}\n                    {% set ref_number = ref.reference_name %}\n                    {% set ref_type = ref.reference_doctype %}\n                    {% set ref_date = None %}\n                {% endif %}\n                <tr>\n                    <td style=\"border:1px solid #ddd; padding:8px;\">\n                        {{ ref_type }}\n                    </td>\n                    <td style=\"border:1px solid #ddd; padding:8px;\">\n                        {{ ref_number }}\n                    </td>\n                    <td style=\"border:1px solid #ddd; padding:8px;\">\n                        {{ frappe.format(ref_date, {\"fieldtype\":\"Date\"}) if ref_date else \"—\" }}\n                    </td>\n                    <td style=\"border:1px solid #ddd; padding:8px; text-align:right;\">\n                        {{ frappe.format(ref.allocated_amount, {\"fieldtype\":\"Currency\"}) }}\n                    </td>\n                </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr style=\"background:#f9f9f9; font-weight:600;\">\n                <td colspan=\"3\" style=\"border:1px solid #ddd; padding:8px; text-align:right;\">\n                    Total Payment:\n                </td>\n                <td style=\"border:1px solid #ddd; padding:8px; text-align:right;\">\n                    {{ frappe.format(pe.paid_amount, {\"fieldtype\":\"Currency\"}) }}\n                </td>\n            </tr>\n        </tfoot>\n    </table>\n\n    <!-- Footer note -->\n    <p style=\"font-size:12px; color:#888; margin-top:20px;\">\n        This payment has been sent to your bank account via EFT.\n        Please allow 1-2 business days for the funds to appear.\n        If you have any questions please contact us.\n    </p>\n\n</div>",
